rules_version = '2';

// ============================================================================
// REGLAS DE SEGURIDAD CLOUD FIRESTORE — REGALOS, DISFRACES Y MÁS "LOS ÁNGELES"
// ============================================================================
// - Lectura pública de catálogo activo (categorías, productos, banners y galería).
// - Escritura de catálogo, inventario y estados de pedidos EXCLUSIVA para la
//   administradora autorizada en la colección `admin_users`.
// - Bloqueo total de auto-registro de administradores desde el cliente (`allow write: if false` en `admin_users`).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica si el usuario autenticado figura en `admin_users/{uid}` o `admin_users/{email}` con `active == true`
    function isAdminDocActive(docId) {
      return exists(/databases/$(database)/documents/admin_users/$(docId)) &&
        get(/databases/$(database)/documents/admin_users/$(docId)).data.active == true;
    }

    function isAdmin() {
      return request.auth != null && (
        isAdminDocActive(request.auth.uid) ||
        (
          request.auth.token.email != null &&
          isAdminDocActive(request.auth.token.email.lower())
        )
      );
    }

    // 1. Colección de Administradores Autorizados
    // La propietaria se da de alta únicamente desde Firebase Console -> Firestore Database.
    // Ningún visitante externo puede escribir en esta colección desde la web.
    match /admin_users/{adminId} {
      allow get: if request.auth != null && (
        request.auth.uid == adminId ||
        (request.auth.token.email != null && request.auth.token.email.lower() == adminId) ||
        isAdmin()
      );
      allow list: if isAdmin();
      allow write: if false;
    }

    // 2. Categorías Oficiales (6 categorías prioritarias)
    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 3. Productos e Inventario (hasta 5 fotografías por producto)
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && (!('images' in request.resource.data) || request.resource.data.images.size() <= 5)
        && (!('price' in request.resource.data) || request.resource.data.price == null || request.resource.data.price >= 0)
        && (!('stock' in request.resource.data) || request.resource.data.stock == null || request.resource.data.stock >= 0);
      allow delete: if isAdmin();
    }

    // 4. Galería "Conoce nuestra tienda"
    match /store_gallery/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 5. Banners Promocionales de Portada
    match /store_banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 6. Pedidos de Clientes (creación pública para envío por WhatsApp; lectura y gestión solo Admin)
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
          'id',
          'customer_name',
          'customer_phone',
          'delivery_method',
          'items',
          'total',
          'status'
        ])
        && request.resource.data.customer_name is string
        && request.resource.data.customer_name.size() > 0
        && request.resource.data.customer_phone is string
        && request.resource.data.customer_phone.size() >= 7
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status in ['pendiente', 'pendiente_whatsapp'];
      allow read, update, delete: if isAdmin();
    }

    // 7. Métricas anónimas agregadas (solo incrementos estrictos de +1; cero sobrescritura ni datos personales)
    function isValidMetricCreate(field) {
      return request.resource.data.keys().hasOnly([field, 'updated_at'])
        && request.resource.data[field] is int
        && request.resource.data[field] == 1
        && request.resource.data.updated_at is string;
    }

    function isValidMetricIncrement(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field, 'updated_at'])
        && request.resource.data[field] is int
        && request.resource.data[field] == (field in resource.data ? resource.data[field] : 0) + 1
        && request.resource.data.updated_at is string;
    }

    match /store_metrics/{metricId} {
      allow read: if isAdmin();
      allow create: if metricId == 'public_clicks' && (
        isValidMetricCreate('catalog_clicks') ||
        isValidMetricCreate('whatsapp_clicks') ||
        isValidMetricCreate('share_clicks') ||
        isValidMetricCreate('qr_downloads')
      );
      allow update: if metricId == 'public_clicks' && (
        isValidMetricIncrement('catalog_clicks') ||
        isValidMetricIncrement('whatsapp_clicks') ||
        isValidMetricIncrement('share_clicks') ||
        isValidMetricIncrement('qr_downloads')
      );
      allow delete: if false;
    }
  }
}
