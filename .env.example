# ============================================================================
# VARIABLES DE ENTORNO — REGALOS, DISFRACES Y MÁS "LOS ÁNGELES"
# ============================================================================
# Copia este archivo como .env.local (nunca subas .env.local a GitHub)

# 1. FIREBASE DE GOOGLE (Autenticación exclusiva propietaria, Cloud Firestore y Storage)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Correo(s) autorizados de la propietaria (opcional, capa extra de seguridad además de Firestore admin_users)
NEXT_PUBLIC_ADMIN_ALLOWED_EMAILS=

# Modo de almacenamiento de fotografías desde celular:
# - "auto" (por defecto: usa Firebase Storage si está activo, o compresión WebP gratuita en Plan Spark)
# - "firestore_inline" (100% gratuito en Plan Spark sin tarjeta bancaria)
# - "cloudinary" (25 GB gratuitos en Cloudinary sin tarjeta bancaria)
NEXT_PUBLIC_STORAGE_MODE=auto

# 2. INTELIGENCIA ARTIFICIAL MULTIMODAL (Exclusiva de servidor para "Agregar producto con IA")
# Google Gemini (recomendado: gemini-2.5-flash en Google AI Studio)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 3. WHATSAPP COMERCIAL OFICIAL (+52 56 3547 8874)
NEXT_PUBLIC_WHATSAPP_NUMBER=525635478874

# 4. SUPABASE (Conservado como respaldo durante la migración controlada)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 5. MERCADO PAGO (Desactivado preventivamente hasta autorización comercial)
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
NEXT_PUBLIC_ENABLE_REAL_PAYMENTS=false
