# ============================================================================
# VARIABLES DE ENTORNO — REGALOS, DISFRACES Y MÁS "LOS ÁNGELES"
# ============================================================================
# Copia este archivo como .env.local (nunca subas .env.local a GitHub)

# 1. SUPABASE (Autenticación de administradora, PostgreSQL y Storage 'store-media')
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica

# 2. INTELIGENCIA ARTIFICIAL MULTIMODAL (Exclusiva de servidor para "Agregar producto con IA")
# Puedes usar Google Gemini (recomendado: gemini-2.5-flash) u OpenAI (gpt-4o-mini)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 3. WHATSAPP COMERCIAL OFICIAL (+52 56 3547 8874)
NEXT_PUBLIC_WHATSAPP_NUMBER=525635478874

# 4. MERCADO PAGO (Desactivado preventivamente hasta autorización comercial)
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
NEXT_PUBLIC_ENABLE_REAL_PAYMENTS=false
